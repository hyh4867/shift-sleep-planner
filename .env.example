# Vercel 프로젝트 환경변수로 설정합니다. 이 파일에 실제 키를 넣지 마세요.
ANTHROPIC_API_KEY=
# 선택: 기본 claude-haiku-5-5
ANTHROPIC_MODEL=
# 선택: 공개 데모 호출 제한 (한국 시간 하루 기준)
DAILY_LIMIT_PER_DEVICE=3
DAILY_LIMIT_PER_IP=20
GLOBAL_DAILY_LIMIT=50
# 공개 배포에서 필수: 없으면 AI를 끄고 "데모 예시" 고정 요약을 보여 줍니다.
# Vercel 마켓플레이스 Upstash(KV) 연동을 쓰면 KV_REST_API_URL / KV_REST_API_TOKEN 이름으로 들어와도 됩니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
